# ─── Application Settings ───────────────────────────────────────────────────
APP_NAME=AFES - Authenticated File Encryption System
APP_ENV=development        # development | production
DEBUG=true
SECRET_KEY=CHANGE_ME_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./afes.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/afes_db

# ─── Envelope Encryption — Key Encryption Key ────────────────────────────────
# 32-byte hex (64 hex chars). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this invalidates ALL existing encrypted files.
MASTER_KEK=CHANGE_ME_64_HEX_CHARS_MASTER_KEY_ENCRYPTION_KEY_HERE

# ─── Cloud Storage ──────────────────────────────────────────────────────────
# Set STORAGE_PROVIDER to "s3" for AWS S3 or "minio" for local MinIO.
STORAGE_PROVIDER=minio

# MinIO (local demo — default)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=afes-encrypted-files
MINIO_SECURE=false

# AWS S3 (production — only set when actually using AWS)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_REGION=us-east-1
# S3_BUCKET=your-afes-encrypted-files-bucket

# ─── File Upload Limits ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
