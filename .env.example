# ─── Authenticated File Encryption System (AFES) Environment Variables ────────
# Copy this file to backend/.env and replace placeholders.

APP_NAME=AFES - Authenticated File Encryption System
APP_ENV=development
DEBUG=true

# ─── Security Secrets ──────────────────────────────────────────────────────────
# JWT signing key (at least 32 characters or 64 hex characters)
SECRET_KEY=CHANGE_ME_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Master Key Encryption Key (32 bytes = 64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEK=CHANGE_ME_64_HEX_CHARS_MASTER_KEY_ENCRYPTION_KEY_HERE

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (Local Development)
DATABASE_URL=sqlite:///./afes.db
# PostgreSQL (Production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/afes_db

# ─── Cloud Storage Configuration ─────────────────────────────────────────────
# Set to "minio" for local S3 simulation OR "s3" for AWS S3
STORAGE_PROVIDER=minio

# Option A: Local MinIO (Default for student demonstration)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=afes-encrypted-files
MINIO_SECURE=false

# Option B: AWS S3 (Production Cloud Mode)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS_REGION=us-east-1
# S3_BUCKET=your-afes-encrypted-files-bucket

# ─── Operational Limits ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
